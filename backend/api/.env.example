# Copy this file to .env and fill in the values. Never commit .env.

# Secret used to sign login tokens (JWT). Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SECRET_KEY=

APP_TIMEZONE=Asia/Manila

# Origin of the Angular app. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:4200

DB_HOST=localhost
DB_NAME=practipro
DB_USER=root
DB_PASSWORD=

# SMTP account used for activation and password-reset emails.
# For Gmail, use an App Password (not your account password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PractiPro
