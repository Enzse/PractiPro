{
    "name": "practipro/backend",
    "description": "PractiPro practicum management API",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "PractiPro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PractiPro\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "migrate": "php bin/migrate.php"
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "sort-packages": true
    }
}
